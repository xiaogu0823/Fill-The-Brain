            )
            return
            
        if not self.camera_manager.cap or not self.camera_manager.cap.isOpened():
            self._show_message_box(
                QMessageBox.Warning,
                self.tr("camera_error_title"),
                self.tr("camera_not_ready_for_recording"),
            )
            return
            
